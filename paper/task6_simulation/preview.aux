\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 独立确认阶段的原假设水平。五个模型—形状单元的四方法拒绝率及逐格双侧95\% Clopper–Pearson区间，共20个点，各格$R=1000$。虚线标示名义水平5\%，浅色带为预定工作性容忍范围[3\%,7\%]，并不改变检验的名义阈值。只有整个区间落入工作带才支持接近，区间跨带界的未决不等于失准；这些逐格区间不代表全表同时保证，也不证明方法间严格等实际水平。固定Fourier的Xue单样本EV扩展中，s5为原主对照，s11/s21为预设敏感性设置。}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:fig01_confirm_size}{{1}{4}{独立确认阶段的原假设水平。五个模型—形状单元的四方法拒绝率及逐格双侧95\% Clopper–Pearson区间，共20个点，各格$R=1000$。虚线标示名义水平5\%，浅色带为预定工作性容忍范围[3\%,7\%]，并不改变检验的名义阈值。只有整个区间落入工作带才支持接近，区间跨带界的未决不等于失准；这些逐格区间不代表全表同时保证，也不证明方法间严格等实际水平。固定Fourier的Xue单样本EV扩展中，s5为原主对照，s11/s21为预设敏感性设置。}{figure.caption.1}{}}
